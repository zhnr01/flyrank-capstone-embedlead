PROJECT_NAME=EmbedLead Widget Platform
ENVIRONMENT=local
SECRET_KEY=replace-with-a-long-random-local-secret
BACKEND_CORS_ORIGINS=["http://localhost:5500"]
POSTGRES_SERVER=db
