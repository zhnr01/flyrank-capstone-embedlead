PROJECT_NAME=EmbedLead Widget Platform
ENVIRONMENT=local
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
MAX_SUBMISSION_BYTES=8192
SUBMISSION_RATE_LIMIT_PER_IP=5
SUBMISSION_RATE_LIMIT_PER_WIDGET=30
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_KEYS=10000
BACKEND_CORS_ORIGINS=["http://localhost:5500"]
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=embedlead
POSTGRES_USER=embedlead
POSTGRES_PASSWORD=replace-local-password
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_STATEMENT_TIMEOUT_MS=2000
REDIS_URL=redis://redis:6379/0
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true
NOTIFICATIONS_ENABLED=true
