PROJECT_NAME=EmbedLead Widget Platform
ENVIRONMENT=local
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
MAX_SUBMISSION_BYTES=8192
SUBMISSION_RATE_LIMIT_PER_IP=5
SUBMISSION_RATE_LIMIT_PER_WIDGET=30
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_KEYS=10000
GEO_ENRICHMENT_ENABLED=true
GEO_PROVIDER_TIMEOUT_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_SECONDS=2.0
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=3.0
WIDGET_BUNDLE_VERSION=v2
WIDGET_CONFIG_CACHE_SECONDS=60
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
METRICS_TOKEN=
METRICS_MAX_ROUTES=64
BACKEND_CORS_ORIGINS=["http://localhost:5500"]
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=embedlead
POSTGRES_USER=embedlead
POSTGRES_PASSWORD=replace-local-password
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_STATEMENT_TIMEOUT_MS=2000
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_CONNECT_TIMEOUT_SECONDS=0.25
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_HEALTH_TIMEOUT_SECONDS=1.0
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true
